{
  "AllowedHosts": "*",
  "RabbitMQ": {
    "Hostname": "127.0.0.1",
    "Username": "admin",
    "Password": "admin",
    "Timeout": 10
  },
  "AppSettings": {
    "Oidc": {
      "Authority": "http://localhost:9000/application/o/gc-front/",
      "Audience": "gc-front",
      "RequireHttpsMetadata": false
    },
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4201",
      "http://localhost:4202",
      "http://127.0.0.1:4200"
    ]
  },
  "GatewayRouting": {
    "Microservices": [
      {
        "Id": "mainsite",
        "Queue": "mainsite_queue",
        "Scope": "Private",
        "Resources": [
          {
            "Type": "INFRA",
            "Name": "Health",
            "Scope": "Public",
            "Actions": [
              {
                "Name": "Check"
              }
            ]
          },
          {
            "Type": "DATA",
            "Name": "Users",
            "Scope": "Private",
            "Actions": [
              {
                "Name": "Load",
                "Scope": "Public"
              }
            ]
          },
          {
            "Type": "DATA",
            "Name": "Countries",
            "Scope": "Private",
            "Actions": [
              {
                "Name": "List",
                "Scope": "Public"
              }
            ]
          },
          {
            "Type": "DATA",
            "Name": "GameTypes",
            "Scope": "Private",
            "Actions": [
              {
                "Name": "List",
                "Scope": "Public"
              }
            ]
          },
          {
            "Type": "DATA",
            "Name": "Games",
            "Scope": "Private",
            "Actions": [
              {
                "Name": "List",
                "Scope": "Public"
              }
            ]
          }
        ]
      },
      {
        "Id": "worldofwarcraft",
        "Queue": "worldofwarcraft_queue",
        "Scope": "Private",
        "Resources": [
          {
            "Type": "INFRA",
            "Name": "Health",
            "Scope": "Public",
            "Actions": [
              {
                "Name": "Check"
              }
            ]
          },
          {
            "Type": "DATA",
            "Name": "Classes",
            "Scope": "Private",
            "Actions": [
              {
                "Name": "List",
                "Scope": "Public"
              }
            ]
          }
        ]
      }
    ]
  }
}
